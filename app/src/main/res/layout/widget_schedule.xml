                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="sans"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/schedule_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/lessonRoom2"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:gravity="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/schedule_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/lessonDivider2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="34dp"
        android:background="@color/schedule_soft"
        android:text=""
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/lessonRow3"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/lessonNumber3"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/widget_badge_bg"
            android:fontFamily="sans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lessonSubject3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/schedule_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lessonTime3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="sans"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/schedule_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/lessonRoom3"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:gravity="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/schedule_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/lessonDivider3"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="34dp"
        android:background="@color/schedule_soft"
        android:text=""
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/lessonRow4"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/lessonNumber4"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/widget_badge_bg"
            android:fontFamily="sans"
            android:gravity="center"
