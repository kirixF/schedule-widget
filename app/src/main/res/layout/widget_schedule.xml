                android:fontFamily="sans"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/schedule_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/lessonRoom3"
