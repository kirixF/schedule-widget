            android:maxLines="2"
            android:textColor="@color/schedule_muted"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/dayCell7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_day_bg"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="@color/schedule_muted"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/nextWeekButton"
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/widget_next_week"
            android:textColor="@color/schedule_accent"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widgetQrImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
