<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ff090d16"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tetris_title"
            android:textColor="#fff8fafc"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPause"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/secondary_button_bg"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/tetris_pause"
            android:textAllCaps="false"
            android:textColor="#fff8fafc"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnRestart"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/secondary_button_bg"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/tetris_new_game"
            android:textAllCaps="false"
            android:textColor="#fff8fafc"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tetris_score"
                android:textColor="#ff94a3b8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#fff8fafc"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tetris_best"
                    android:textColor="#ff94a3b8"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvHighScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#fff8fafc"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tetris_level"
                    android:textColor="#ff94a3b8"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="#fff8fafc"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tetris_lines"
                    android:textColor="#ff94a3b8"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvLines"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#fff8fafc"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.kirix.schedule.TetrisBoardView
            android:id="@+id/boardView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tetris_next"
                android:textColor="#ff94a3b8"
                android:textSize="11sp" />

            <com.kirix.schedule.TetrisNextQueueView
                android:id="@+id/nextQueueView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLeft"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/secondary_button_bg"
                android:contentDescription="@string/tetris_left_desc"
                android:text="&#8592;"
                android:textAllCaps="false"
                android:textColor="#fff8fafc"
                android:textSize="26sp" />

            <Button
                android:id="@+id/btnRotate"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/secondary_button_bg"
                android:contentDescription="@string/tetris_rotate_desc"
                android:text="@string/tetris_rotate"
                android:textAllCaps="false"
                android:textColor="#fff8fafc"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnRight"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@drawable/secondary_button_bg"
                android:contentDescription="@string/tetris_right_desc"
                android:text="&#8594;"
                android:textAllCaps="false"
                android:textColor="#fff8fafc"
                android:textSize="26sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSoftDrop"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/secondary_button_bg"
                android:contentDescription="@string/tetris_soft_drop_desc"
                android:text="@string/tetris_soft_drop"
                android:textAllCaps="false"
                android:textColor="#fff8fafc"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnHardDrop"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginStart="3dp"
                android:layout_weight="2"
                android:background="@drawable/secondary_button_bg"
                android:contentDescription="@string/tetris_hard_drop_desc"
                android:text="@string/tetris_hard_drop"
                android:textAllCaps="false"
                android:textColor="#fff8fafc"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
