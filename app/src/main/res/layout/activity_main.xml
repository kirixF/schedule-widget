<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?scheduleBg"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="?scheduleText"
            android:textSize="30sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/app_subtitle"
            android:textColor="?scheduleMuted"
            android:textSize="15sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/step_badge_bg"
                    android:gravity="center"
                    android:text="@string/step_1"
                    android:textColor="?scheduleAccent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Группа / Преподаватель"
                    android:textColor="?scheduleText"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:id="@+id/sectionGroupHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/section_group_hint"
                android:textColor="?scheduleMuted"
                android:textSize="14sp" />
            <RadioGroup
                android:id="@+id/typeRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/radioGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Группа"
                    android:textColor="?scheduleText"
                    android:textSize="16sp" />
                <RadioButton
                    android:id="@+id/radioTeacher"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="Преподаватель"
                    android:textColor="?scheduleText"
                    android:textSize="16sp" />
            </RadioGroup>
            <EditText
                android:id="@+id/groupInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/edit_bg"
                android:hint="@string/group_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters"
                android:maxLines="1"
                android:textColor="?scheduleText"
                android:textColorHint="?scheduleMuted"
                android:textSize="18sp" />
            <Button
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/button_bg"
                android:text="@string/save_refresh"
                android:textAllCaps="false"
                android:textColor="#ffffffff"
                android:textSize="16sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/step_badge_bg"
                    android:gravity="center"
                    android:text="@string/step_2"
                    android:textColor="?scheduleAccent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/section_day"
                    android:textColor="?scheduleText"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/section_day_hint"
                android:textColor="?scheduleMuted"
                android:textSize="14sp" />
            <Button
                android:id="@+id/dayPickerButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/secondary_button_bg"
                android:text="@string/select_day"
                android:textAllCaps="false"
                android:textColor="?scheduleText"
                android:textSize="16sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/step_badge_bg"
                    android:gravity="center"
                    android:text="@string/step_3"
                    android:textColor="?scheduleAccent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/section_widget"
                    android:textColor="?scheduleText"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/section_widget_hint"
                android:textColor="?scheduleMuted"
                android:textSize="14sp" />
            <Button
                android:id="@+id/pinWidgetButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/secondary_button_bg"
                android:text="@string/pin_widget"
                android:textAllCaps="false"
                android:textColor="?scheduleText"
                android:textSize="16sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Погода"
                android:textColor="?scheduleText"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Выберите город прогноза. Если города нет в списке — откройте его страницу на gismeteo.ru в браузере и вставьте ссылку сюда."
                android:textColor="?scheduleMuted"
                android:textSize="14sp" />
            <Button
                android:id="@+id/cityPickerButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/secondary_button_bg"
                android:text="@string/weather_city_default"
                android:textAllCaps="false"
                android:textColor="?scheduleText"
                android:textSize="16sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_status"
                android:textColor="?scheduleText"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/status_bg"
                android:lineSpacingExtra="3dp"
                android:textColor="?scheduleText"
                android:textSize="15sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="QR-код для прохода"
                android:textColor="?scheduleText"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Прикрепите фотографию QR-кода из галереи, чтобы быстро открывать её на виджете при входе в колледж."
                android:textColor="?scheduleMuted"
                android:textSize="14sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/pickQrButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/secondary_button_bg"
                    android:text="Выбрать из галереи"
                    android:textAllCaps="false"
                    android:textColor="?scheduleText"
                    android:textSize="16sp" />
                <Button
                    android:id="@+id/clearQrButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/button_bg"
                    android:backgroundTint="#ffef4444"
                    android:text="Удалить"
                    android:textAllCaps="false"
                    android:textColor="#ffffffff"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </LinearLayout>
            <ImageView
                android:id="@+id/qrPreviewImage"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:background="@drawable/status_bg"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Оформление"
                android:textColor="?scheduleText"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Выберите оформление и цветовой акцент для приложения и виджета."
                android:textColor="?scheduleMuted"
                android:textSize="14sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Тема виджета:"
                android:textColor="?scheduleText"
                android:textSize="14sp"
                android:textStyle="bold" />
            <RadioGroup
                android:id="@+id/themeRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">
                <RadioButton
                    android:id="@+id/radioThemeDarkGlass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Темное стекло (полупрозрачная)"
                    android:textColor="?scheduleText"
                    android:textSize="15sp" />
                <RadioButton
                    android:id="@+id/radioThemeLightGlass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Светлое стекло (полупрозрачная)"
                    android:textColor="?scheduleText"
                    android:textSize="15sp" />
                <RadioButton
                    android:id="@+id/radioThemeDark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Темная классическая"
                    android:textColor="?scheduleText"
                    android:textSize="15sp" />
                <RadioButton
                    android:id="@+id/radioThemeLight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Светлая классическая"
                    android:textColor="?scheduleText"
                    android:textSize="15sp" />
            </RadioGroup>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Цветовая палитра:"
                android:textColor="?scheduleText"
                android:textSize="14sp"
                android:textStyle="bold" />
            <RadioGroup
                android:id="@+id/colorRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">
                <RadioButton
                    android:id="@+id/radioColorIndigo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Индиго (неоновый)"
                    android:textColor="?scheduleText"
                    android:textSize="15sp" />
                <RadioButton
                    android:id="@+id/radioColorMint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Мятный (светло-зеленый)"
                    android:textColor="?scheduleText"
                    android:textSize="15sp" />
                <RadioButton
                    android:id="@+id/radioColorEmerald"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Изумрудный (зеленый)"
                    android:textColor="?scheduleText"
                    android:textSize="15sp" />
                <RadioButton
                    android:id="@+id/radioColorRed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Гранатовый (красный)"
                    android:textColor="?scheduleText"
                    android:textSize="15sp" />
                <RadioButton
                    android:id="@+id/radioColorOrange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Янтарный (оранжевый)"
                    android:textColor="?scheduleText"
                    android:textSize="15sp" />
            </RadioGroup>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:alpha="0.6"
            android:gravity="center"
            android:text="powered by V.D.Z"
            android:textColor="?scheduleMuted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
